# ─────────────────────────────────────────────
# Wrenify Environment Configuration
# Copy this file to `.env` and fill in values
# ─────────────────────────────────────────────

# Genius API token (optional — for fetching lyrics)
# Get one free at: https://genius.com/api-clients
GENIUS_TOKEN=

# Enable verbose logging (true/false)
DEBUG=false

# Override default audio device (leave blank for system default)
# List devices: python -c "import sounddevice; print(sounddevice.query_devices())"
AUDIO_DEVICE_INDEX=

# Override webcam device (default: 0)
WEBCAM_INDEX=0
