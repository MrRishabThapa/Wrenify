# ─────────────────────────────────────────────
# Wrenify Environment Configuration
# Copy this file to `.env` and fill in values
# Defaults are tuned for 8GB RAM systems
# ─────────────────────────────────────────────

# ── Lyrics (optional) ──
# Genius API token for fetching lyrics
# Get one free at: https://genius.com/api-clients
GENIUS_TOKEN=

# ── Debug ──
# Enable verbose logging (true/false)
DEBUG=false

# ── Audio ──
# Override default mic device (leave blank for system default)
# List devices: python -c "import sounddevice; print(sounddevice.query_devices())"
AUDIO_DEVICE_INDEX=

# ── Webcam ──
# Override webcam device index (default: 0)
WEBCAM_INDEX=0

# ── Speech Recognition (faster-whisper) ──

# Whisper model size — RAM usage in parentheses (int8 mode)
#   tiny      (~500MB)  — fastest, ok for 4GB systems
#   base      (~800MB)  — RECOMMENDED for 8GB (this default)
#   small     (~1.5GB)  — better accuracy, 16GB+ recommended
#   medium    (~3.5GB)  — accurate, needs 16GB+ or GPU
#   large-v3  (~6.0GB)  — best, requires GPU practically
WHISPER_MODEL=base

# Compute device: cpu, cuda, auto
# cpu = works everywhere
# cuda = requires NVIDIA GPU + CUDA installed
# auto = detect CUDA, fall back to CPU
WHISPER_DEVICE=cpu

# Compute type — quantization for the model
#   int8     — smallest RAM, fastest on CPU (RECOMMENDED for CPU)
#   float16  — smallest RAM on GPU (RECOMMENDED for CUDA)
#   float32  — most accurate but 2x RAM usage
WHISPER_COMPUTE_TYPE=int8